# 复制为 .env 并填入真实值。.env 已被 .gitignore 排除。
#
# 键名必须和 src/sandbox/config.py 里的字段一字不差（前缀之外）。
# 写错的变量不会报错也不会进日志——它会被静默丢掉，那个值从来没生效过，
# 而报告上完全看不出来。沙箱在启动时会核对这件事并拒绝启动，
# 把那几个没人读的变量名列出来。

# --- 真实上游（默认不用）-------------------------------------------------
# 默认 stub：脚本化的假上游，行为完全确定，用来验证管道本身。
# 要接真实模型时把这三行都填上：MODE 换 real、KEY 填真实密钥。
SANDBOX_UPSTREAM_MODE=stub
SANDBOX_UPSTREAM_BASE_URL=https://api.deepseek.com
SANDBOX_UPSTREAM_API_KEY=

# --- 远程重型机（W3 之后）------------------------------------------------
# SANDBOX_DATABASE_URL=postgresql+asyncpg://user:pw@host/db
# SANDBOX_LANGFUSE_HOST=
# SANDBOX_LANGFUSE_PUBLIC_KEY=
# SANDBOX_LANGFUSE_SECRET_KEY=

# --- 长期预算预警（需求场景 4）-------------------------------------------
# 0 = 不设限（默认）。超预算不会让任何运行失败，只出现在报告和
# scripts/cost_report.py 里。
SANDBOX_COST_BUDGET_DAILY_USD=0
SANDBOX_COST_BUDGET_WEEKLY_USD=0
SANDBOX_COST_BUDGET_MONTHLY_USD=0
