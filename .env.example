# 复制为 .env 并填入真实值。.env 已被 .gitignore 排除。
SANDBOX_DEEPSEEK_API_KEY=
SANDBOX_DEEPSEEK_BASE_URL=https://api.deepseek.com
# 远程重型机（W3 之后）：
# SANDBOX_DATABASE_URL=postgresql+asyncpg://user:pw@host/db
# SANDBOX_LANGFUSE_HOST=
# SANDBOX_LANGFUSE_PUBLIC_KEY=
# SANDBOX_LANGFUSE_SECRET_KEY=
# 长期预算预警（需求场景 4）。0 = 不设限（默认）。
# 超预算不会让任何运行失败，只出现在报告和 scripts/cost_report.py 里。
SANDBOX_COST_BUDGET_DAILY_USD=0
SANDBOX_COST_BUDGET_WEEKLY_USD=0
SANDBOX_COST_BUDGET_MONTHLY_USD=0
